<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit_financing" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.financing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Header button -->
            <xpath expr="//header" position="inside">
                <button name="action_create_loan"
                        string="Créer un prêt"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'sale' or loan_application_count > 0"/>
            </xpath>

            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-money"
                        type="object"
                        name="action_view_loan_applications"
                        invisible="loan_application_count == 0">
                    <field name="loan_application_count" widget="statinfo" string="Prêts"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>
