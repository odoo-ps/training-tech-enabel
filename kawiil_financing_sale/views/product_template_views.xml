<odoo>
    <record id="product_template_form_finance" model="ir.ui.view">
        <field name="name">product.template.form.finance</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group" position="inside">
                <field name="is_financeable"/>
            </xpath>

        </field>
    </record>
</odoo>
