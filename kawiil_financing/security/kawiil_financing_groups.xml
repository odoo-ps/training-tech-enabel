<odoo>

    <record id="privilege_financing" model="res.groups.privilege">
        <field name="name">Financing</field>
        <field name="category_id" ref="kawiil_financing.module_category_dealership"/>
    </record>

    <record id="group_financing_user" model="res.groups">
        <field name="name">Financing User</field>
        <field name="privilege_id" ref="kawiil_financing.privilege_financing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_financing_admin" model="res.groups">
        <field name="name">Financing Admin</field>
        <field name="privilege_id" ref="kawiil_financing.privilege_financing"/>
        <field name="implied_ids" eval="[(4, ref('kawiil_financing.group_financing_user'))]"/>
    </record>

</odoo>
