<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_res_partner" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_partner_form_kawiil" model="ir.ui.view">
        <field name="name">res.partner.form.kawiil</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-money"
                        type="object"
                        name="action_view_loan_applications">
                    <field name="loan_application_count" widget="statinfo" string="Loan Applications"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
