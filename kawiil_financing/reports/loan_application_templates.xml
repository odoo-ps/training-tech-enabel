<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_loan_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout" t-lang="doc.partner_id.lang">
                    <div class="page">
                        <h2 t-field="doc.name"/>

                        <p>
                            <strong>Client : </strong>
                            <span t-field="doc.partner_id"/>
                        </p>

                        <p>
                            <strong>Montant principal : </strong>
                            <span t-field="doc.loan_amount"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </p>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.document_ids" t-as="document">
                                    <tr>
                                        <td><span t-field="document.name"/></td>
                                        <td><span t-field="document.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
